{
  "name": "@brightwork/api",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx --env-file-if-exists=../../.env src/server.ts --serve-web",
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts",
    "test:integration": "tsx --test test/auth.test.ts test/automation.test.ts test/shopify.test.ts test/sms.test.ts test/meta-page-store.test.ts test/stripe-connect.test.ts test/referrals.test.ts test/commerce-insights.test.ts test/media-store.test.ts",
    "test:research": "tsx --test test/research.test.ts",
    "test:growth": "node --import tsx --test test/growth.test.ts test/github-site-sync.test.ts test/meta-page-webhook.test.ts test/stripe-connect-provider.test.ts test/media-providers.test.ts test/public-plans.test.ts"
  },
  "dependencies": {
    "@brightwork/shared": "workspace:*",
    "fastify": "^5.6.1",
    "zod": "^4.1.12",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.7",
    "nodemailer": "^7.0.10",
    "jose": "^6.1.0",
    "ioredis": "^5.8.2",
    "bullmq": "^5.81.3",
    "cheerio": "1.1.2"
  },
  "devDependencies": {
    "tsx": "^4.20.6",
    "@types/nodemailer": "^7.0.2"
  },
  "exports": {
    "./agent": "./src/workspace/agent-store.ts",
    "./database": "./src/db/database.ts",
    "./credits": "./src/workspace/credits.ts",
    "./runs": "./src/workspace/run-store.ts",
    "./run-plan": "./src/workspace/run-plan.ts",
    "./schedule": "./src/workspace/task-automation.ts",
    "./mail": "./src/workspace/mail-store.ts",
    "./llm": "./src/llm.ts",
    "./public-page": "./src/research/page.ts",
    "./media-store": "./src/workspace/media-store.ts",
    "./media-providers": "./src/workspace/media-providers.ts"
  }
}
