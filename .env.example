# Local-only defaults used by compose.yaml. Set strong credentials in deployments.
APP_ORIGIN=http://127.0.0.1:5173
API_PORT=3001
DATABASE_URL=postgresql://brightwork:brightwork-local@127.0.0.1:5432/brightwork
REDIS_URL=redis://127.0.0.1:6379
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=brightwork-local
S3_SECRET_KEY=brightwork-local-storage
S3_BUCKET=brightwork-sites
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAIL_FROM=Brightwork <hello@brightwork.test>

# Generate AUTH_SECRET with openssl rand -hex 32. Use your own provider values.
AUTH_SECRET=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
GOOGLE_CLIENT_ID=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Configure a provider, then start the worker for Pip chat.
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1

# Optional standalone web research. Use http://127.0.0.1:8080 for local Compose.
# Generate SEARXNG_SECRET with openssl rand -hex 32.
SEARXNG_BASE_URL=
SEARXNG_SECRET=
# Increase for slower local models if the default 10 seconds per model call is too short.
RESEARCH_MODEL_TIMEOUT_SECONDS=10

# Growth providers are available only to this Brightwork workspace UUID.
GROWTH_WORKSPACE_ID=
GROWTH_META_PAGE_ID=
GROWTH_META_PAGE_TOKEN=
GROWTH_META_AD_ACCOUNT_ID=
GROWTH_META_AD_TOKEN=
GROWTH_GOOGLE_LOCATION_ID=
GROWTH_GOOGLE_ACCESS_TOKEN=

# Optional public web search through OpenAI Responses.
WEB_SEARCH_API_KEY=
WEB_SEARCH_MODEL=

# Optional approved outbound email using a verified Resend sender address.
OUTREACH_RESEND_API_KEY=
OUTREACH_FROM_EMAIL=

# Optional incoming mail through a Resend receiving domain.
INBOUND_EMAIL_DOMAIN=
INBOUND_RESEND_API_KEY=
INBOUND_RESEND_WEBHOOK_SECRET=

# Wildcard DNS must send *.SITE_BASE_DOMAIN to the API. Leave blank for draft previews only.
SITE_BASE_DOMAIN=

# Internal credit quotas for Pip.
STARTER_CREDITS=10.0000000000
MODEL_CREDITS_PER_CALL=0.1000000000
TOOL_CREDITS_PER_CALL=0.0100000000
