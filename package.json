{
  "name": "brightwork",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @brightwork/web --filter @brightwork/api dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "contracts:generate": "node scripts/generate-contracts.mjs",
    "contracts:check": "node scripts/generate-contracts.mjs --check",
    "contracts:replay": "node --experimental-strip-types scripts/replay-har.mjs",
    "parity:check": "node scripts/check-parity-inventory.mjs",
    "branding:check": "node scripts/check-brightwork-branding.mjs",
    "test": "playwright test",
    "test:ssr": "playwright test -c playwright.ssr.config.ts",
    "visual:report": "node scripts/visual-report.mjs",
    "test:unit": "node --experimental-strip-types --test tests/unit/*.test.ts",
    "verify:doctor": "bash .cursor/skills/verify-brightwork/scripts/doctor.sh",
    "verify:invariants": "bash scripts/verify-invariants.sh",
    "verify:feature": "node .cursor/skills/verify-brightwork/scripts/verify-feature.mjs",
    "verify:ready": "node .cursor/skills/verify-brightwork/scripts/drive-ready.mjs",
    "verify:gallery": "node .cursor/skills/verify-brightwork/scripts/drive-gallery.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.18.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.4.0",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
